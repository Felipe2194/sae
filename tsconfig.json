{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": [
    "node_modules",
    // Script local suelto (se corre con `tsx`, no es parte de la app) que
    // importa db/datos-importacion-sae.json — ese JSON está en .gitignore
    // (tiene teléfonos) y no existe en un clone limpio, así que `next build`
    // fallaba el typecheck en cualquier entorno que no sea la máquina que lo
    // generó.
    "db/importar-visitas-sae.ts"
  ]
}
