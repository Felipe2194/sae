# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# claude code local settings (machine-specific)
.claude/settings.local.json

# typescript
*.tsbuildinfo
next-env.d.ts

# datos reales de importación (contactos de colegios: nombres, emails,
# teléfonos) — solo para uso local del script db/importar-visitas-sae.ts,
# nunca al repo público
/db/datos-importacion-sae.json
