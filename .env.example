# Copiar a .env.local y completar los valores.

# Conexión a PostgreSQL (docker compose up -d levanta la base en localhost:5433 —
# se remapeó desde el 5432 default de Postgres porque en este entorno de desarrollo
# ese puerto lo ocupa el contenedor de otro proyecto local)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/sae

# Auth.js — generar con: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Login con Google (usado por el botón "Continuar con Google" en /login)
# Crear credenciales OAuth 2.0 en console.cloud.google.com → APIs y servicios →
# Credenciales → ID de cliente OAuth (tipo "Aplicación web"). Como URI de
# redirección autorizado agregar: <AUTH_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Google Calendar (opcional — sin estas vars se muestran eventos de ejemplo)
# 1. Crear proyecto en console.cloud.google.com → activar "Google Calendar API"
# 2. Crear API Key (restricción: Calendar API) → pegar en GOOGLE_CALENDAR_API_KEY
# 3. El calendario debe ser público o compartido. Ir a Configuración del calendario
#    → "Integrar calendario" → copiar el "ID de calendario" en GOOGLE_CALENDAR_ID
GOOGLE_CALENDAR_API_KEY=
GOOGLE_CALENDAR_ID=

# Escritura en Google Calendar (opcional — sin estas vars, "Nueva reunión" en
# /admin crea la tarea igual pero no la agenda en Google Calendar).
# 1. En el mismo proyecto de Cloud, crear una cuenta de servicio (IAM y
#    administración → Cuentas de servicio → Crear) y una clave JSON para ella.
# 2. Compartir el calendario de GOOGLE_CALENDAR_ID con el email de esa cuenta
#    de servicio, con permiso "Hacer cambios en los eventos".
# 3. Del JSON descargado: client_email → GOOGLE_CALENDAR_SERVICE_ACCOUNT_EMAIL,
#    private_key → GOOGLE_CALENDAR_SERVICE_ACCOUNT_KEY (pegar tal cual, con
#    los \n literales — se des-escapan solos).
GOOGLE_CALENDAR_SERVICE_ACCOUNT_EMAIL=
GOOGLE_CALENDAR_SERVICE_ACCOUNT_KEY=

# Selector de archivos de Drive al adjuntar en una tarea (opcional — sin
# estas vars el botón "Elegir de Drive" no aparece, solo queda el adjunto
# manual por nombre+URL). Mismo proyecto de Google Cloud que el login y
# Calendar. Ver docs/credenciales-pendientes.md sección 7.
# 1. Habilitar "Google Drive API" y "Google Picker API" en el proyecto.
# 2. NEXT_PUBLIC_GOOGLE_CLIENT_ID = mismo valor que AUTH_GOOGLE_ID (el client
#    ID de OAuth no es secreto, solo el secret).
# 3. NEXT_PUBLIC_GOOGLE_PICKER_API_KEY = una API key nueva restringida a la
#    Picker API (no reusar GOOGLE_CALENDAR_API_KEY, que está restringida a
#    Calendar).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_PICKER_API_KEY=

# Widget "Música de la oficina" en /hoy — embed de YouTube (opcional, sin
# estas vars usa una playlist propia por defecto; no requiere cuenta ni
# credencial). Para apuntar a otro video/transmisión/playlist: pegar el ID
# (la parte después de v= o list= en la URL de YouTube — los de playlist
# empiezan con "PL" y se detectan solos).
NEXT_PUBLIC_YOUTUBE_EMBED_ID=
NEXT_PUBLIC_YOUTUBE_EMBED_NOMBRE=

# Notificaciones por Telegram al grupo del equipo (opcional — sin estas vars
# solo quedan las notificaciones in-app). Ver docs/credenciales-pendientes.md
# para cómo crear el bot y conseguir el chat_id del grupo.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Dueño de la plataforma: único que ve /plataforma y puede crear
# organizaciones (secretarías) nuevas y asignarles usuarios. Al loguearse por
# primera vez con Google usando este email, entra ya activo como
# administrador de la organización por defecto + superadmin de plataforma.
SUPERADMIN_EMAIL=
